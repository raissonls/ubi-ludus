{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/raissonls/ubi-ludus/main/schemas/teams.schema.json",
  "title": "teams.json",
  "description": "Published file: teams.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "description": "Version of this file's format. Bump it when the format changes."
    },
    "generated_at": {
      "$ref": "common.schema.json#/$defs/utc_timestamp",
      "description": "When the pipeline produced this file."
    },
    "teams": {
      "type": "array",
      "items": {
        "$ref": "team.schema.json"
      }
    }
  },
  "required": [
    "schema_version",
    "generated_at",
    "teams"
  ],
  "additionalProperties": false
}
