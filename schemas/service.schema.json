{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/raissonls/ubi-ludus/main/schemas/service.schema.json",
  "title": "Service",
  "description": "A subscription a visitor can have, and the broadcasters it includes.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "name": {
      "$ref": "common.schema.json#/$defs/text"
    },
    "includes_broadcasters": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "id",
    "name",
    "includes_broadcasters"
  ],
  "additionalProperties": false
}
