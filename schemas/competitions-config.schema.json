{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/raissonls/ubi-ludus/main/schemas/competitions-config.schema.json",
  "title": "config/competitions.yml",
  "description": "Hand-edited config: which competitions we follow, which provider serves each one, and how many days ahead that provider can tell us. A competition with no sources is listed as 'not covered yet'.",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "competitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "name": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "country_or_region": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "type": {
            "enum": ["league", "cup"]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "provider": {
                  "$ref": "common.schema.json#/$defs/id",
                  "description": "Name of a registered adapter. A name with no adapter fails the run before any call is made."
                },
                "provider_id": {
                  "type": ["string", "integer"],
                  "description": "The competition's identifier at that provider, for example BSA or 71."
                },
                "horizon_days": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 14,
                  "description": "How many days ahead the provider can tell us: 14 for a full window, 1 for 'until tomorrow'."
                }
              },
              "required": ["provider", "provider_id", "horizon_days"],
              "additionalProperties": false
            }
          }
        },
        "required": ["id", "name", "country_or_region", "type", "sources"],
        "additionalProperties": false
      }
    }
  },
  "required": ["version", "competitions"],
  "additionalProperties": false
}
