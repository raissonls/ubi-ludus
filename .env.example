# Copy to .env and fill in. Never commit .env (it is git-ignored).
# In CI, these live in GitHub Secrets.
FOOTBALL_DATA_TOKEN=
API_FOOTBALL_KEY=

# The morning e-mail (docs/email.md). In CI these are GitHub Secrets.
# SMTP_HOST and SMTP_PORT are optional (default smtp-relay.brevo.com and 587).
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
